# Copy to .env.agent and fill in. Never commit. Used only by the agent process,
# e.g. node --env-file=.env.agent ...
# The starter submits with PRIVATE_KEY and pays x402 with PAYER_PRIVATE_KEY,
# so both are the agent key here. Needs Base Sepolia ETH (gas) + aUSD (x402).
# Separate key from the deployer so the agent loop and manual scripts never collide on nonces.

PRIVATE_KEY=0x...
PAYER_PRIVATE_KEY=0x...
RPC_URL=https://...
CONSUMER_ADDRESS=0x...
