# Copy to .env and fill in. Never commit .env. Fresh burner wallets only (cast wallet new).

# Deployer key: deploys the contract and runs manual demo scripts. Needs Base Sepolia ETH
PRIVATE_KEY=0x...

# Dedicated RPC (Alchemy/QuickNode free key). Public fallback: https://sepolia.base.org (rate-limited)
RPC_URL=https://...

# Printed by the deploy script (the starter default is an anvil address, replace it)
CONSUMER_ADDRESS=0x...

# For forge verify-contract on Basescan (Etherscan v2 API key)
ETHERSCAN_API_KEY=...
